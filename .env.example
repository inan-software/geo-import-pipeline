# Copy to .env and set your own values. Never commit .env.
POSTGRES_DB=geodata
POSTGRES_USER=geodata
POSTGRES_PASSWORD=change-me

# Host name of the database service. Set this when attaching to an existing compose setup.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Optional: pin the PostGIS image. Default is the current postgis/postgis release.
# POSTGIS_IMAGE=postgis/postgis:17-3.5

# Optional runtime settings (defaults shown)
# GIP_TIMEZONE=UTC
# GIP_USER_AGENT=geo-import-pipeline/0.1
# GIP_LOG_LEVEL=INFO
